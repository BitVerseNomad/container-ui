{
  "name": "colima-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "test": "node --experimental-strip-types --no-warnings --test \"src/**/*.test.ts\" && vitest run",
